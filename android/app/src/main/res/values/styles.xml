<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Edge-to-edge: biarin konten digambar di belakang status bar &
             navigation bar. Ini yang bikin StatusBar.setOverlaysWebView(true)
             dari Capacitor plugin beneran ngefek — kalau cuma diset di JS
             tanpa ini, webview tetep "didorong turun" oleh sistem window
             insets bawaan Android, jadi kelihatan sama aja kayak sebelumnya.
             statusBarColor sengaja dibiarkan transparent di sini — warna
             SOLID yang beneran keliatan diatur lewat StatusBar plugin di JS
             (App.jsx), yang jalan tiap kali app dibuka/tema berubah. -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- android:windowLayoutInDisplayCutoutMode butuh API 28+ tapi aman
             dideklarasikan di sini (minSdk 24) — cuma no-op di API lama. -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>