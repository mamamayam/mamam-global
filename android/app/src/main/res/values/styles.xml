<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Edge-to-edge: konten digambar di belakang status bar & navigation
             bar. windowTranslucentStatus (cara lama) SENGAJA tidak dipakai —
             API itu deprecated & gak reliable lagi di targetSdk 35+ (Android
             15 mewajibkan edge-to-edge), penyebab ikon jam/baterai jadi
             belang/samar di percobaan sebelumnya. Setup edge-to-edge yang
             beneran ngefek sekarang ada di MainActivity.java lewat
             WindowCompat.setDecorFitsSystemWindows(false) (API modern).
             statusBarColor tetap transparent sebagai base — warna SOLID yang
             keliatan (mengikuti tema light/dark) diatur lewat Capacitor
             StatusBar plugin di JS (App.jsx), jalan tiap app dibuka/tema
             berubah. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- android:windowLayoutInDisplayCutoutMode butuh API 28+ tapi aman
             dideklarasikan di sini (minSdk 24) — cuma no-op di API lama. -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>